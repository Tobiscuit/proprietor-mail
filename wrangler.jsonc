{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proprietor-mail",
  "main": "src/index.ts",
  // 2026-08-15 is the newest date BOTH installed runtimes support: the test
  // pool (@cloudflare/vitest-pool-workers 0.22.0) ships workerd 1.20260815.1,
  // wrangler 4.141.0 ships 1.20260925.1. Nothing here depends on how RPC
  // serializes errors: MailService answers with values, refusals included
  // (contracts/mail-service-v1.md), because a thrown error lost its name and
  // fields between two processes even at this date.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  // No public HTTP surface at all (plan.md §3): reached by Email Routing, by
  // service binding and by its own cron, nothing else. `fetch` answers 404 to
  // everything.
  "workers_dev": false,
  "preview_urls": false,

  // The Worker's own log lines carry ids, sizes, counts and outcomes only
  // (domain-model M1, spec D8). Invocation logs are off: Workers Logs would
  // otherwise record each email invocation with its envelope recipient
  // (domain-model G25, spec D20).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },

  // The Mail Directory: Mail's own D1, never another application's. Named by
  // name only (domain-model G24): wrangler resolves the database by
  // `database_name`, so no resource identifier is published with the code.
  // The database is created with wrangler before the first deploy (plan.md
  // §15); local runs (`wrangler dev --local`, the tests) use the name as is.
  "d1_databases": [
    {
      "binding": "DIRECTORY",
      "database_name": "proprietor-mail",
      "migrations_dir": "migrations"
    }
  ],

  // One object per message: mbx/<mailboxId>/msg/<messageId>, the sealed raw
  // message. Nothing else is written to R2.
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "proprietor-mail" }],

  // One Mailbox Agent (a SQLite-backed Durable Object) per mailbox. The
  // binding NAME is what routeAgentEmail's resolver returns as `agentName`:
  // agents 0.24.0 matches it against the env keys (exact, kebab-case or
  // lower-case), not against the class name.
  "durable_objects": {
    "bindings": [{ "name": "Mailbox", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }],

  // The deliverability feed (plan.md §13): every five minutes, `scheduled()`
  // reads Mail's own SES events queue and hands bounces and complaints to
  // their mailboxes.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "SES_REGION": "us-east-1"
  }

  // Secrets (the operator's secret store → process environment →
  // `wrangler secret put` reading stdin; never argv and never a kept file):
  //   MAIL_CAPABILITY_KEYS   the capability keys (contracts/capability-v1.md)
  //   SES_ACCESS_KEY_ID      the client-mail IAM principal (plan.md §6); it
  //   SES_SECRET_ACCESS_KEY    sends through SES and reads the events queue
  //   MAIL_EVENTS_QUEUE_URL  Mail's own SES events queue (plan.md §13); a
  //                          secret because it names the AWS account
  //
  // The new-mail signal (plan.md §1, seam 4). Until the dashboard Worker exports
  // `MailSignals`, the NewMailSignal port has a no-op adapter; then:
  //   "services": [
  //     { "binding": "MAIL_SIGNALS", "service": "<dashboard worker>", "entrypoint": "MailSignals" }
  //   ]
}
