{
  "name": "@proprietor/mail-crypto",
  "version": "0.0.0",
  "description": "Envelope v1 and key wrapping for proprietor-mail (contracts/envelope-v1.md). Runs in the browser and in Workers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tobiscuit/proprietor-mail.git",
    "directory": "packages/mail-crypto"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.workers.json && tsc -p tsconfig.test.json",
    "write-vectors": "WRITE_VECTORS=1 vitest run test/vectors.write.test.ts"
  },
  "dependencies": {
    "@hpke/common": "1.10.1",
    "@hpke/core": "1.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
