    "dev": "wrangler dev --local --port 8787",
    "provision": "node scripts/provision-mailbox.ts"
  },
  "dependencies": {
    "agents": "0.26.0",
    "aws4fetch": "1.0.20",
    "jose": "6.2.12",
    "postal-mime": "3.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260925.1": true,
    "esbuild@0.28.1": true
  }
}
